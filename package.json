{
  "name": "calculadora-saas",
  "version": "1.0.0",
  "type": "module",
  "description": "A calculadora mais completa do mundo (por apenas R$5/mês) - meme SaaS",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "css": "tailwindcss -i styles/input.css -o public/css/style.css --minify",
    "css:watch": "tailwindcss -i styles/input.css -o public/css/style.css --watch",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "saas",
    "calculadora",
    "mercado-pago",
    "meme"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.2",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mathjs": "^15.2.0",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "sharp": "^0.35.3",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
