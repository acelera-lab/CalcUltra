# ---- App ----
PORT=3016
# URL pública do site (webhook do MP, SEO, links dos emails). Em produção: https://calc.esc-software.com
# Em dev sem URL pública (ex.: localhost), o webhook do MP precisa de túnel (ngrok).
APP_URL=http://localhost:3016
DB_PATH=./data/db.sqlite
# Obrigatório em produção! Com o valor padrão, o app se recusa a subir.
SESSION_SECRET=mude-isso-por-favor
# Cookie de sessão com Secure. Auto: true se APP_URL for https, false se http (ex.: localhost).
# Use SECURE_COOKIES=true em produção e SECURE_COOKIES=false se o APP_URL não refletir o protocolo real.
#SECURE_COOKIES=

# ---- Mercado Pago (obrigatório pra cobrar de verdade) ----
MP_ACCESS_TOKEN=APP_USR-0000000000000000000000000000000000000-000000-0000000000000000000000000000000000000000
# Segredo do webhook (x-signature). Sem isso, o webhook aceita qualquer um.
MP_WEBHOOK_SECRET=

# ---- OpenRouter (Resolvedor de contas de prova) ----
# Key em https://openrouter.ai/keys
OPENROUTER_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free
#OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,cohere/north-mini-code:free,google/gemma-4-26b-a4b-it:free

# ---- SMTP (emails de boas-vindas e lembretes) ----
# Sem isso, os emails são só logados (modo simulação).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
# Lembretes: intervalo do ciclo (horas) e mínimo de dias entre emails pro mesmo usuário
#REMINDER_INTERVAL_HOURS=6
#REMINDER_MIN_DAYS=3
