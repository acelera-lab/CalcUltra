<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <%
  const pageTitle = typeof title !== 'undefined' && title ? title + ' | ' : '';
  const seoDescription = typeof seo !== 'undefined' && seo.description ? seo.description : 'A calculadora mais completa do mundo. Disponível em três edições: Semanal, Mensal e Vitalícia.';
  const seoTitle = pageTitle + 'CalcUltra Deluxe Edition';
  const seoUrl = (typeof seo !== 'undefined' && seo.canonical) ||
    (typeof appUrl !== 'undefined' ? appUrl : '') + (typeof path !== 'undefined' ? path : '');
  const ogImage = (typeof appUrl !== 'undefined' ? appUrl : '') + '/og-image.png';
  %>
  <title><%= seoTitle %></title>
  <meta name="description" content="<%= seoDescription %>" />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#F5F0EB" />
  <link rel="canonical" href="<%= seoUrl %>" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="CalcUltra Deluxe Edition" />
  <meta property="og:title" content="<%= seoTitle %>" />
  <meta property="og:description" content="<%= seoDescription %>" />
  <meta property="og:url" content="<%= seoUrl %>" />
  <meta property="og:image" content="<%= ogImage %>" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= seoTitle %>" />
  <meta name="twitter:description" content="<%= seoDescription %>" />
  <meta name="twitter:image" content="<%= ogImage %>" />
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2032%2032'%3E%3Crect%20width='32'%20height='32'%20rx='7'%20fill='%231E4FE8'/%3E%3Crect%20x='7'%20y='5'%20width='18'%20height='12'%20rx='3'%20fill='%23F5C518'%20stroke='%23fff'%20stroke-width='2'/%3E%3Cpath%20d='M11%2010h4'%20stroke='%231A1A1A'%20stroke-width='2'%20stroke-linecap='round'/%3E%3Ccircle%20cx='10'%20cy='21'%20r='2'%20fill='%23fff'/%3E%3Ccircle%20cx='16'%20cy='21'%20r='2'%20fill='%23fff'/%3E%3Ccircle%20cx='22'%20cy='21'%20r='2'%20fill='%23fff'/%3E%3Ccircle%20cx='13'%20cy='27'%20r='2'%20fill='%23fff'/%3E%3Ccircle%20cx='19'%20cy='27'%20r='2'%20fill='%23fff'/%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,700;0,9..144,800;0,9..144,900;1,9..144,700;1,9..144,800&family=Montserrat:wght@400;500;600;700;800&family=Google+Sans+Code:ital,wght,MONO@0,300..800,1;1,300..800,1&display=swap" onload="this.rel='stylesheet'" />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" onload="this.rel='stylesheet'" />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,700;0,9..144,800;0,9..144,900;1,9..144,700;1,9..144,800&family=Montserrat:wght@400;500;600;700;800&family=Google+Sans+Code:ital,wght,MONO@0,300..800,1;1,300..800,1&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  </noscript>
  <link rel="stylesheet" href="/css/style.css" />
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
</head>
<body class="min-h-screen flex flex-col bg-paper text-ink font-body">
  <main class="flex-1">
